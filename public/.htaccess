<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # 1. Обязательно: проброс Bearer-токена в PHP для Laravel API
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Если файл или папка реально существуют (assets, js, css, картинки) — отдаем как есть
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Всё, что начинается с /api — отдаем в Laravel
    RewriteRule ^api(/.*)?$ index.php [L]

    # 4. Всё остальное — отдаем в SPA frontend
    RewriteRule ^ index.html [L]
</IfModule>